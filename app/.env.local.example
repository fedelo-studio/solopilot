# SoloPilot — Variables d'environnement
# Copie ce fichier vers .env.local et remplis les valeurs.
# Tant que ces variables sont vides, l'app fonctionne en mode mock data.

# Supabase (requis pour l'auth et la base de données)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel — pour scripts de seed côté serveur uniquement, ne JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Mode de l'app : "mock" force les données fictives même si Supabase est configuré
NEXT_PUBLIC_DATA_MODE=mock
